#--------------------------------------------------------------------
# NORSU Student Record System - local settings for the Warden environment
# Copy this file to src/.env (src/.env is ignored by Git).
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://student-record-system.test/'
app.indexPage = ''
app.appTimezone = 'Asia/Manila'

#--------------------------------------------------------------------
# DATABASE (Warden MariaDB defaults)
#--------------------------------------------------------------------

database.default.hostname = db
database.default.database = app
database.default.username = app
database.default.password = app
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
